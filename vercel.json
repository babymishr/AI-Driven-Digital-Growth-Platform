{
  "version": 2,
  "builds": [
    {
      "src": "ai-driven-digital-growth-platform/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/ai-driven-digital-growth-platform/dist/$1"
    }
  ]
}
